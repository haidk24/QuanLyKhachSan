@model Team_Project_4.Models.Taikhoan

@{
    ViewData["Title"] = "Login";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

<style>
    body {
        background-image: url('/images/pexels-beyzaerdem-19849574.jpg');
        backdrop-filter: blur(5px);
        backdrop-filter: brightness(0.4);
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
        height: 100vh;
        margin: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .card-container {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-card {
        background: rgba(50, 50, 50, 0.8);
        border-radius: 20px;
        padding: 40px 30px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
        width: 100%;
        max-width: 400px;
        animation: fadeIn 0.6s ease-in-out;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

        .login-card h2 {
            color: #ffffff;
            font-weight: 600;
            margin-bottom: 30px;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-label {
        color: #e0e0e0;
        font-weight: 500;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #ffffff;
        border-radius: 0 10px 10px 0;
    }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.15);
            border-color: #d4af37;
            box-shadow: 0 0 8px rgba(212, 175, 55, 0.5);
            color: #ffffff;
        }

    .input-group-text {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-right: none;
        border-radius: 10px 0 0 10px;
    }

    .btn-login {
        background: linear-gradient(135deg, #d4af37 0%, #aa8c2c 100%);
        color: #1a1a1a;
        border-radius: 10px;
        transition: 0.3s;
        font-weight: 600;
        border: none;
    }

        .btn-login:hover {
            background: linear-gradient(135deg, #f0c84a 0%, #c9a945 100%);
            color: #1a1a1a;
            transform: scale(1.05);
            box-shadow: 0 5px 20px rgba(212, 175, 55, 0.6);
        }

    .toggle-password {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-left: none;
        color: #d4af37;
        cursor: pointer;
    }

        .toggle-password:hover {
            color: #f0c84a;
        }

    .form-icon {
        width: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        color: #d4af37;
    }

    .alert-danger {
        background: rgba(220, 53, 69, 0.2);
        border: 1px solid rgba(220, 53, 69, 0.4);
        color: #ff6b6b;
    }

    .text-danger {
        color: #ff6b6b !important;
    }
</style>

<div class="card-container">
    <div class="login-card">
        <h2 class="text-center mb-7">WELCOME !</h2>

        @if (!string.IsNullOrEmpty(ViewBag.error))
        {
            <div class="alert alert-danger">@ViewBag.error</div>
        }

        <form asp-action="Login" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Username -->
            <div class="mb-3">
                <label asp-for="Tentknv" class="form-label">Tài khoản</label>
                <div class="input-group">
                    <span class="input-group-text form-icon">
                        <i class="bi bi-person-fill"></i>
                    </span>
                    <input asp-for="Tentknv" class="form-control" placeholder="Nhập tài khoản" />
                </div>
                <span asp-validation-for="Tentknv" class="text-danger"></span>
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label asp-for="Mktk" class="form-label">Mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text form-icon">
                        <i class="bi bi-lock-fill"></i>
                    </span>
                    <input asp-for="Mktk" class="form-control" type="password" id="passwordInput" placeholder="Nhập mật khẩu" />
                    <button type="button" class="toggle-password input-group-text" id="togglePassword">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Mktk" class="text-danger"></span>
            </div>

            <div class="d-grid mt-4">
                <input type="submit" value="Đăng nhập" class="btn btn-login btn-lg" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('passwordInput');

        togglePassword.addEventListener('click', () => {
            const type = passwordInput.type === 'password' ? 'text' : 'password';
            passwordInput.type = type;
            togglePassword.innerHTML = type === 'password'
                ? '<i class="bi bi-eye"></i>'
                : '<i class="bi bi-eye-slash"></i>';
        });
    </script>

    @await Html.PartialAsync("_ValidationScriptsPartial")
}