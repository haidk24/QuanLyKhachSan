@model Team_Project_4.Models.Taikhoan

@{
    ViewData["Title"] = "Register";
    Layout = "_ManagerLayout";
}
@if (ViewBag.success != null)
{
    <div class="alert alert-success" role="alert">
        @ViewBag.success
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
    </div>
}

<h1 class="text-center">CẤP TÀI KHOẢN</h1>
<div class="row justify-content-center">
    <div class="col-md-6">
        <form asp-action="Register" id="registerForm" method="post">
            <p>@ViewBag.success</p>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Dropdown Mã nhân viên -->
            <div class="form-group">
                <label asp-for="Manv" class="font-weight-bold">Mã nhân viên</label>
                <select class="form-control" asp-for="Manv" id="employeeId" asp-items="ViewBag.EmployeeIdList">
                    <option value="0">Tất cả</option>
                </select>
                <span asp-validation-for="Manv" class="text-danger"></span>
            </div>

            <!-- Dropdown Loại tài khoản (role) -->
            <div class="form-group">
                <label class="font-weight-bold">Loại tài khoản</label>
                <select class="form-control" id="roleSelect" asp-items="ViewBag.RoleList" name="selectedRole">
                    <option value="">-- Chọn loại --</option>
                </select>
            </div>

            <!-- Hiển thị thông tin cơ bản nhân viên (readonly) -->
            <div class="form-group">
                <label class="font-weight-bold">Họ tên</label>
                <input type="text" id="hotenDisplay" class="form-control" readonly placeholder="Chọn mã NV để hiển thị" />
            </div>
            <div class="form-group">
                <label class="font-weight-bold">Phái</label>
                <input type="text" id="phaiDisplay" class="form-control" readonly placeholder="Chọn mã NV để hiển thị" />
            </div>
            <div class="form-group">
                <label class="font-weight-bold">Ngày sinh</label>
                <input type="text" id="ngaysinhDisplay" class="form-control" readonly placeholder="Chọn mã NV để hiển thị" />
            </div>
            <div class="form-group">
                <label class="font-weight-bold">Số điện thoại</label>
                <input type="text" id="sdtDisplay" class="form-control" readonly placeholder="Chọn mã NV để hiển thị" />
            </div>

            <!-- Tên tài khoản (generated tự động) -->
            <div class="form-group">
                <label asp-for="Tentknv" class="font-weight-bold">Tên tài khoản (tự động)</label>
                <div class="input-group">
                    <input asp-for="Tentknv" type="text" id="emailField" class="form-control" readonly placeholder="Chọn mã NV và loại để hiển thị" />
                </div>
                <span asp-validation-for="Tentknv" class="text-danger"></span>
            </div>

            <!-- Mật khẩu mặc định -->
            <div class="form-group">
                <label asp-for="Mktk" class="control-label font-weight-bold">Mật khẩu tài khoản</label>
                <input asp-for="Mktk" class="form-control" type="text" id="passwordField" value="123456789" readonly />
                <span asp-validation-for="Mktk" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Tạo" class="btn btn-primary float-md-end" onclick="return confirm('Bạn chắc chắn muốn cấp tài khoản không?');" />
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách tài khoản đã tạo -->
<div class="container mt-5">
    <h2 class="text-center">Danh sách tài khoản</h2>
    <div class="row mb-3">
        <div class="col-md-6 offset-md-3">
            <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm theo mã NV, họ tên, số ĐT, hoặc Gmail..." />
        </div>
    </div>
    <table class="table table-striped table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Mã NV</th>
                <th>Họ tên</th>
                <th>Số ĐT</th>
                <th>Gmail</th>
                <th>Tên TK</th>
                <th>Mật khẩu</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody id="accountTableBody">
            @if (ViewBag.AccountList != null)
            {
                var accounts = ViewBag.AccountList as List<AccountViewModel>;
                @foreach (var account in accounts)
                {
                    <tr>
                        <td>@account.Manv</td>
                        <td>@account.Hoten</td>
                        <td>@account.Sdt</td>
                        <td>@account.Gmail</td>
                        <td>@account.Tentknv</td>
                        <td>@account.Mktk</td>
                        <td>
                            <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#deleteModal_@account.Manv">
                                Xóa
                            </button>
                            <!-- Modal xác nhận xóa -->
                            <div class="modal fade" id="deleteModal_@account.Manv" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel_@account.Manv" aria-hidden="true">
                                <div class="modal-dialog" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="deleteModalLabel_@account.Manv">Xác nhận xóa</h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <div class="modal-body">
                                            Bạn chắc chắn muốn xóa tài khoản của mã NV @account.Manv?
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                                            <form asp-action="DeleteAccount" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="manv" value="@account.Manv" />
                                                <button type="submit" class="btn btn-danger">Xóa</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="7" class="text-center">Không có tài khoản nào</td></tr>
            }
        </tbody>
    </table>
</div>

<script>
    // Lấy data từ ViewBag
    var employeeList = @Html.Raw(ViewBag.EmployeeList);
    var employeeIdDropDown = document.getElementById("employeeId");
    var roleSelect = document.getElementById("roleSelect");
    var hotenDisplay = document.getElementById("hotenDisplay");
    var phaiDisplay = document.getElementById("phaiDisplay");
    var ngaysinhDisplay = document.getElementById("ngaysinhDisplay");
    var sdtDisplay = document.getElementById("sdtDisplay");
    var emailField = document.getElementById("emailField");
    var passwordField = document.getElementById("passwordField");
    var accountTableBody = document.getElementById("accountTableBody");
    var searchInput = document.getElementById("searchInput");

    // Fallback
    var empIds = @Html.Raw(Json.Serialize(ViewBag.EmployeeIdList));
    var emailFromBag = @Html.Raw(Json.Serialize(ViewBag.EmployeeEmailList));

    // Set default
    emailField.value = "";
    passwordField.value = "123456789";
    clearDisplays();

    // Clear all display fields
    function clearDisplays() {
        hotenDisplay.value = "";
        phaiDisplay.value = "";
        ngaysinhDisplay.value = "";
        sdtDisplay.value = "";
        emailField.value = "";
    }

    // Helper remove dấu tiếng Việt cho JS preview
    function removeVietnameseAccents(text) {
        if (!text) return text;
        var map = {
            'à': 'a', 'á': 'a', 'ạ': 'a', 'ả': 'a', 'ã': 'a', 'â': 'a', 'ầ': 'a', 'ấ': 'a', 'ậ': 'a', 'ẩ': 'a', 'ẫ': 'a', 'ă': 'a', 'ằ': 'a', 'ắ': 'a', 'ặ': 'a', 'ẳ': 'a', 'ẵ': 'a',
            'è': 'e', 'é': 'e', 'ẹ': 'e', 'ẻ': 'e', 'ẽ': 'e', 'ê': 'e', 'ề': 'e', 'ế': 'e', 'ệ': 'e', 'ể': 'e', 'ễ': 'e',
            'ì': 'i', 'í': 'i', 'ị': 'i', 'ỉ': 'i', 'ĩ': 'i',
            'ò': 'o', 'ó': 'o', 'ọ': 'o', 'ỏ': 'o', 'õ': 'o', 'ô': 'o', 'ồ': 'o', 'ố': 'o', 'ộ': 'o', 'ổ': 'o', 'ỗ': 'o', 'ơ': 'o', 'ờ': 'o', 'ớ': 'o', 'ợ': 'o', 'ở': 'o', 'ỡ': 'o',
            'ù': 'u', 'ú': 'u', 'ụ': 'u', 'ủ': 'u', 'ũ': 'u', 'ư': 'u', 'ừ': 'u', 'ứ': 'u', 'ự': 'u', 'ử': 'u', 'ữ': 'u',
            'ỳ': 'y', 'ý': 'y', 'ỵ': 'y', 'ỷ': 'y', 'ỹ': 'y',
            'đ': 'd',
            'À': 'A', 'Á': 'A', 'Ạ': 'A', 'Ả': 'A', 'Ã': 'A', 'Â': 'A', 'Ầ': 'A', 'Ấ': 'A', 'Ậ': 'A', 'Ẩ': 'A', 'Ẫ': 'A', 'Ă': 'A', 'Ằ': 'A', 'Ắ': 'A', 'Ặ': 'A', 'Ẳ': 'A', 'Ẵ': 'A',
            'È': 'E', 'É': 'E', 'Ẹ': 'E', 'Ẻ': 'E', 'Ẽ': 'E', 'Ê': 'E', 'Ề': 'E', 'Ế': 'E', 'Ệ': 'E', 'Ể': 'E', 'Ễ': 'E',
            'Ì': 'I', 'Í': 'I', 'Ị': 'I', 'Ỉ': 'I', 'Ĩ': 'I',
            'Ò': 'O', 'Ó': 'O', 'Ọ': 'O', 'Ỏ': 'O', 'Õ': 'O', 'Ô': 'O', 'Ồ': 'O', 'Ố': 'O', 'Ộ': 'O', 'Ổ': 'O', 'Ỗ': 'O', 'Ơ': 'O', 'Ờ': 'O', 'Ớ': 'O', 'Ợ': 'O', 'Ở': 'O', 'Ỡ': 'O',
            'Ù': 'U', 'Ú': 'U', 'Ụ': 'U', 'Ủ': 'U', 'Ũ': 'U', 'Ư': 'U', 'Ừ': 'U', 'Ứ': 'U', 'Ự': 'U', 'Ử': 'U', 'Ữ': 'U',
            'Ỳ': 'Y', 'Ý': 'Y', 'Ỵ': 'Y', 'Ỷ': 'Y', 'Ỹ': 'Y',
            'Đ': 'D'
        };
        return text.split('').map(function(char) {
            return map[char] || char;
        }).join('').replace(/\s+/g, '');
    }

    // Generate Tentknv preview
    function generateTentknv(hoten, ngaysinh, suffix) {
        var fullNameNormalized = removeVietnameseAccents(hoten);
        var lastNameNormalized = fullNameNormalized.split(/[\s. -]+/).pop();
        var dobStr = new Date(ngaysinh).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).replace(/\//g, '');
        var baseUser = lastNameNormalized + dobStr;
        return baseUser + suffix;
    }

    // Event listener cho Manv change
    employeeIdDropDown.addEventListener("change", function () {
        var selectedManv = parseInt(this.value);
        var selectedRole = roleSelect.value;

        if (selectedManv === 0) {
            clearDisplays();
            emailField.value = "";
        } else {
            var selectedEmployee = employeeList.find(function(emp) {
                return emp.manv === selectedManv;
            });

            if (selectedEmployee) {
                hotenDisplay.value = selectedEmployee.hoten || "";
                phaiDisplay.value = selectedEmployee.phai || "";
                ngaysinhDisplay.value = selectedEmployee.ngaysinh ? new Date(selectedEmployee.ngaysinh).toLocaleDateString('vi-VN') : "";
                sdtDisplay.value = selectedEmployee.sdt || "";

                if (selectedRole) {
                    var suffix = selectedRole === "NhanVien" ? "@@staff.hotel" : "@@manager.hotel";
                    emailField.value = generateTentknv(selectedEmployee.hoten, selectedEmployee.ngaysinh, suffix);
                } else {
                    emailField.value = "";
                }
            } else {
                clearDisplays();
                emailField.value = "";
            }
        }

        passwordField.value = "123456789";
    });

    // Event listener cho role change
    roleSelect.addEventListener("change", function () {
        var selectedManv = parseInt(employeeIdDropDown.value);
        if (selectedManv !== 0 && selectedManv > 0) {
            var selectedEmployee = employeeList.find(function(emp) {
                return emp.manv === selectedManv;
            });

            if (selectedEmployee) {
                var suffix = this.value === "NhanVien" ? "@@staff.hotel" : "@@manager.hotel";
                emailField.value = generateTentknv(selectedEmployee.hoten, selectedEmployee.ngaysinh, suffix);
            }
        }
    });

    // Tìm kiếm bảng tài khoản theo Mã NV, Họ tên, Số ĐT, hoặc Gmail
    searchInput.addEventListener("input", function () {
        var searchTerm = removeVietnameseAccents(this.value.toLowerCase());
        var rows = accountTableBody.getElementsByTagName("tr");

        for (var i = 0; i < rows.length; i++) {
            var manv = removeVietnameseAccents(rows[i].cells[0].textContent.toLowerCase()); // Mã NV
            var hoten = removeVietnameseAccents(rows[i].cells[1].textContent.toLowerCase()); // Họ tên
            var sdt = removeVietnameseAccents(rows[i].cells[2].textContent.toLowerCase()); // Số ĐT
            var gmail = removeVietnameseAccents(rows[i].cells[3].textContent.toLowerCase()); // Gmail
            if (manv.includes(searchTerm) || hoten.includes(searchTerm) || sdt.includes(searchTerm) || gmail.includes(searchTerm)) {
                rows[i].style.display = "";
            } else {
                rows[i].style.display = "none";
            }
        }
    });
</script>