<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Team_Project_4</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Team_Project_4.styles.css" asp-append-version="true" />
    <style>
        /* Style chỉ áp dụng trong sidebar để tránh ảnh hưởng toàn cục */
        #sidebar .nav-link {
            color: #ccc;
            transition: background-color 0.3s, color 0.3s, box-shadow 0.3s; /* Thêm transition cho glow */
            width: 100%;
            padding: 0.5rem 1rem 0.5rem 0.75rem;
            border-radius: 0 8px 8px 0; /* Bo góc chỉ bên phải cho top-level sát nền */
            text-align: left;
            margin: 0;
            box-sizing: border-box; /* Bao gồm padding trong width */
        }

        /* Hover: Màu #7f8c8d với viền phát sáng nhẹ */
        #sidebar .nav-link:hover {
            background-color: #7f8c8d;
            color: #fff;
            box-shadow: 0 0 8px rgba(127, 140, 141, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.1); /* Glow nhẹ bên ngoài + viền sáng trong */
        }

        /* Active: Màu #303952 với viền phát sáng */
        #sidebar .nav-link.active {
            background-color: #303952;
            color: #fff !important;
            font-weight: 600;
            box-shadow: 0 0 10px rgba(48, 57, 82, 0.8), inset 0 0 0 1px rgba(255, 255, 255, 0.2); /* Glow mạnh hơn cho active, khớp màu mới */
        }

        /* Biểu tượng cũng đổi màu - chỉ trong sidebar */
        #sidebar .nav-link.active i,
        #sidebar .nav-link:hover i {
            color: #fff;
        }

        /* Kích thước biểu tượng top-level: to */
        #sidebar > div > ul > li > .nav-link .bi {
            font-size: 1.5rem;
            width: 1.5rem;
            text-align: center;
            flex-shrink: 0;
        }

        /* Kích thước biểu tượng submenu: nhỏ gọn hơn để tránh tràn */
        #sidebar .collapse .nav-link .bi {
            font-size: 0.875rem; /* Nhỏ hơn nữa */
            width: 0.875rem;
            margin-right: 0.25rem; /* Spacing rất nhỏ */
            flex-shrink: 0;
        }

        /* Full-width cho ul và nav-item để nav-link ôm sát nền đen */
        #sidebar ul {
            width: 100%;
            padding: 0;
            margin: 0;
        }

        #sidebar .nav-item {
            width: 100%;
            padding: 0;
            margin-bottom: 0.25rem;
        }

        /* Style riêng cho submenu: gọn hơn, indent vừa, KHÔNG TRÀN */
        #sidebar .collapse {
            width: 100%;
            padding: 0;
            margin: 0;
        }

        #sidebar .collapse .nav-link {
            padding: 0.375rem 0.5rem 0.375rem 1.5rem; /* Giảm padding-right sát cạnh, indent 1.5rem */
            border-radius: 8px; /* Bo góc full cho submenu */
            font-size: 0.875rem; /* Text nhỏ gọn hơn */
            margin-bottom: 0.125rem; /* Spacing nhỏ */
            max-width: 100%; /* Ép không vượt width parent */
            overflow: hidden; /* Ẩn nếu text quá dài (fallback) */
            white-space: nowrap; /* Không wrap text để gọn */
            box-sizing: border-box;
        }

        /* Áp dụng hover/active cho submenu */
        #sidebar .collapse .nav-link:hover {
            background-color: #7f8c8d;
            color: #fff;
            box-shadow: 0 0 8px rgba(127, 140, 141, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.1); /* Glow nhất quán */
        }

        /* Active cho submenu: Màu #303952 với viền phát sáng */
        #sidebar .collapse .nav-link.active {
            background-color: #303952;
            color: #fff !important;
            box-shadow: 0 0 10px rgba(48, 57, 82, 0.8), inset 0 0 0 1px rgba(255, 255, 255, 0.2); /* Glow mạnh hơn cho active, khớp màu mới */
        }

        /* Fixed sidebar setup */
        #sidebar {
            width: 280px;
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            z-index: 1030;
            transition: transform 0.3s ease-in-out;
            overflow: hidden; /* Ngăn tràn toàn bộ sidebar */
        }

        /* Content margin để tránh overlap */
        .main-content {
            margin-left: 280px;
            transition: margin-left 0.3s ease-in-out;
            min-height: 100vh;
        }

        /* Mobile: ẩn sidebar và reset margin */
        @@media (max-width: 767.98px) {
            #sidebar {
                transform: translateX(-100%);
            }
            #sidebar.show {
                transform: translateX(0);
            }
            .main-content {
                margin-left: 0;
            }
        }

        /* Overlay backdrop khi sidebar show trên mobile */
        #sidebar.show ~ .main-content::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1029;
        }
    </style>
</head>
<body>
    <div class="d-flex min-vh-100">
        <!-- Sidebar -->
        <nav id="sidebar" class="bg-dark px-1 pt-2 text-white">
            <div class="d-flex flex-column align-items-start min-vh-100">
                <button id="menuToggle" class="d-md-none btn btn-dark mb-3 ms-1">
                    <i class="bi bi-list"></i>
                </button>
                <a href="/" class="d-flex align-items-center pb-3 mb-md-0 me-md-auto text-white text-decoration-none w-100 ps-1">
                    <span class="fs-5">Quản lý khách sạn</span>
                </a>
                <ul class="nav flex-column mb-sm-auto mb-0" id="menu" role="navigation">
                    <li class="nav-item">
                        <a asp-controller="Manager" asp-action="Index" asp-route-manager="1" class="nav-link d-flex align-items-center text-white">
                            <i class="bi bi-house-fill"></i><span class="ms-2">Home</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Nhanvien" asp-action="NhanvienList" class="nav-link d-flex align-items-center text-white">
                            <i class="bi bi-people-fill"></i><span class="ms-2">Nhân viên</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Client" asp-action="ClientList" asp-route-manager="1" class="nav-link d-flex align-items-center text-white">
                            <i class="bi bi-person-circle"></i><span class="ms-2">Khách</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Room" asp-action="RoomList" asp-route-manager="1" class="nav-link d-flex align-items-center text-white">
                            <i class="bi bi-building"></i><span class="ms-2">Phòng</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Rent" asp-action="Index" asp-route-manager="1" class="nav-link d-flex align-items-center text-white">
                            <i class="bi bi-card-list"></i><span class="ms-2">Phiếu thuê</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Bill" asp-action="Index" asp-route-manager="1" class="nav-link d-flex align-items-center text-white">
                            <i class="bi bi-receipt"></i><span class="ms-2">Hóa Đơn</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="#submenu5" data-bs-toggle="collapse" aria-expanded="false" aria-controls="submenu5" class="nav-link d-flex align-items-center text-white">
                            <i class="bi bi-flag"></i><span class="ms-2">Báo cáo</span>
                        </a>
                        <ul class="collapse nav flex-column ms-2" id="submenu5" data-bs-parent="#menu"> <!-- Giảm ms-3 → ms-2 để indent vừa -->
                            <li class="nav-item">
                                <a asp-controller="SaleReport" asp-action="Index" asp-route-manager="1" class="nav-link d-flex align-items-center text-white">
                                    <i class="bi bi-flag-fill"></i><span class="ms-1">Báo cáo doanh thu</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Room" asp-action="RoomUsageReport" asp-route-manager="1" class="nav-link d-flex align-items-center text-white">
                                    <i class="bi bi-flag-fill"></i><span class="ms-1">Báo cáo tỷ lệ dùng</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a href="#submenu6" data-bs-toggle="collapse" aria-expanded="false" aria-controls="submenu6" class="nav-link d-flex align-items-center text-white">
                            <i class="bi bi-file-ruled"></i><span class="ms-2">Quy Định</span>
                        </a>
                        <ul class="collapse nav flex-column ms-2" id="submenu6" data-bs-parent="#menu"> <!-- Giảm ms-3 → ms-2 -->
                            <li class="nav-item">
                                <a asp-controller="LoaiPhong" asp-action="RoomType" class="nav-link d-flex align-items-center text-white">
                                    <i class="bi bi-file-ruled-fill"></i><span class="ms-1">Loại phòng</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="SettingLoaiKhach" asp-action="ClientType" class="nav-link d-flex align-items-center text-white">
                                    <i class="bi bi-file-ruled-fill"></i><span class="ms-1">Loại khách</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Phuthu" asp-action="Edit" asp-route-id="1" class="nav-link d-flex align-items-center text-white">
                                    <i class="bi bi-file-ruled-fill"></i><span class="ms-1">Tỷ lệ phụ thu</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Account" asp-action="Register" class="nav-link d-flex align-items-center text-white">
                            <i class="bi bi-person-fill-add"></i><span class="ms-2">Cấp tài khoản</span>
                        </a>
                    </li>
                </ul>
                <li class="nav-item mt-auto">
                    <a asp-controller="Account" asp-action="Logout" class="nav-link d-flex align-items-center text-white text-decoration-none">
                        <i class="bi bi-box-arrow-left"></i><span class="ms-2">Đăng xuất</span>
                    </a>
                </li>
            </div>
        </nav>

        <!-- Main content -->
        <main class="main-content flex-grow-1 py-3">
            @if (ViewContext.View != null)
            {
                @RenderBody()
            }
            else
            {
                <p>Không thể tải nội dung trang.</p>
            }
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
          const normalizePath = path => path.replace(/\/+$/, ''); // bỏ dấu '/' cuối

          const currentUrl = normalizePath(new URL(window.location.href).pathname.toLowerCase());

          document.querySelectorAll('#menu a[href]:not([href^="#"])').forEach(link => {
            try {
              const linkHref = normalizePath(new URL(link.href, window.location.origin).pathname.toLowerCase());

              if (currentUrl === linkHref) {
                link.classList.add('active');

                const parentCollapse = link.closest('.collapse');
                if (parentCollapse) {
                  parentCollapse.classList.add('show');

                  const parentLi = parentCollapse.parentElement;
                  const parentLink = parentLi.querySelector(`a[href="#${parentCollapse.id}"]`);
                  if (parentLink) parentLink.classList.add('active');
                }
              }
            } catch (e) {
              console.warn('Invalid href:', link.href);
            }
          });
        });


        // Mobile toggle (giữ nguyên)
        document.getElementById('menuToggle').addEventListener('click', () => {
            document.getElementById('sidebar').classList.toggle('show');
        });

        // Ẩn sidebar khi click ngoài (mobile only)
        document.addEventListener('click', (e) => {
            if (window.innerWidth < 768 && !e.target.closest('#sidebar') && !e.target.closest('#menuToggle')) {
                document.getElementById('sidebar').classList.remove('show');
            }
        });

        // Xử lý resize window để reset sidebar nếu cần
        window.addEventListener('resize', () => {
            if (window.innerWidth >= 768) {
                document.getElementById('sidebar').classList.remove('show');
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>