@{
    string userRole = Context.Session.GetString("UserRole");
    if (userRole == "Manager")
    {
        Layout = "_ManagerLayout";
    }
    else if (userRole == "Staff")
    {
        Layout = "_StaffLayout";    
    }
}

@RenderBody()

@{
    if (IsSectionDefined("Scripts"))
    {
        RenderSection("Scripts", required: false);
    }
}