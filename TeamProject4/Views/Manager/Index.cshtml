@model Team_Project_4.Models.Nhanvien
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Manager Home";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    * {
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    .welcome-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 3rem 2rem;
        margin-bottom: 3rem;
        box-shadow: 0 15px 40px rgba(102, 126, 234, 0.3);
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .welcome-header::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        animation: pulse 3s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); opacity: 0.5; }
        50% { transform: scale(1.1); opacity: 0.8; }
    }

    .welcome-header h1 {
        color: white;
        font-weight: 700;
        font-size: 3rem;
        margin-bottom: 1rem;
        text-shadow: 0 4px 8px rgba(0,0,0,0.2);
        position: relative;
        z-index: 1;
    }

    .welcome-header .subtitle {
        color: rgba(255, 255, 255, 0.95);
        font-size: 1.3rem;
        font-weight: 500;
        position: relative;
        z-index: 1;
    }

    .welcome-header .manager-name {
        color: #ffd700;
        font-weight: 700;
    }

    .dashboard-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
        padding: 0 1.5rem;
    }

    .dashboard-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .dashboard-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, var(--card-color-start), var(--card-color-end));
    }

    .dashboard-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 40px rgba(0,0,0,0.15);
    }

    .dashboard-card.card-purple {
        --card-color-start: #667eea;
        --card-color-end: #764ba2;
    }

    .dashboard-card.card-blue {
        --card-color-start: #4facfe;
        --card-color-end: #00f2fe;
    }

    .dashboard-card.card-pink {
        --card-color-start: #f093fb;
        --card-color-end: #f5576c;
    }

    .dashboard-card.card-orange {
        --card-color-start: #fa709a;
        --card-color-end: #fee140;
    }

    .card-icon {
        width: 70px;
        height: 70px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin-bottom: 1.5rem;
        color: white;
    }

    .card-purple .card-icon {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .card-blue .card-icon {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    }

    .card-pink .card-icon {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    }

    .card-orange .card-icon {
        background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
    }

    .card-title {
        font-size: 1rem;
        color: #6c757d;
        margin-bottom: 0.5rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .card-value {
        font-size: 2.5rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 1rem;
    }

    .card-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #667eea;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .card-link:hover {
        gap: 0.75rem;
        color: #764ba2;
    }

    .quick-actions {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        margin-bottom: 2rem;
    }

    .quick-actions h2 {
        color: #2c3e50;
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .quick-actions h2 i {
        color: #667eea;
    }

    .action-buttons {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .action-btn {
        padding: 1rem 1.5rem;
        border-radius: 12px;
        border: none;
        font-weight: 600;
        color: white;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .action-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 25px rgba(0,0,0,0.15);
        color: white;
    }

    .action-btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .action-btn-success {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    }

    .action-btn-warning {
        background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
    }

    .action-btn-info {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    }

    .info-section {
        background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
        border-radius: 16px;
        padding: 1.5rem;
        margin: 2rem;
    }

    .info-section h3 {
        color: #2c3e50;
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .info-section p {
        color: #555;
        font-size: 1.05rem;
        line-height: 1.8;
        margin-bottom: 0;
    }

    @@media (max-width: 768px) {
        .welcome-header h1 {
            font-size: 2rem;
        }

        .welcome-header .subtitle {
            font-size: 1rem;
        }

        .dashboard-cards {
            grid-template-columns: 1fr;
        }

        .action-buttons {
            grid-template-columns: 1fr;
        }
    }

    /* Animation on load */
    .dashboard-card {
        animation: fadeInUp 0.6s ease-out backwards;
    }

    .dashboard-card:nth-child(1) { animation-delay: 0.1s; }
    .dashboard-card:nth-child(2) { animation-delay: 0.2s; }
    .dashboard-card:nth-child(3) { animation-delay: 0.3s; }
    .dashboard-card:nth-child(4) { animation-delay: 0.4s; }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="welcome-header">
    <h1>
        <i class="fas fa-hand-sparkles me-3"></i>
        Chào mừng quản lý
    </h1>
    <p class="subtitle">
        @if (Model != null)
        {
            <span>Xin chào, <span class="manager-name">@Model.Hoten</span>! </span>
        }
        Chúc bạn một ngày làm việc hiệu quả.
    </p>
</div>

<div class="dashboard-cards">
    <div class="dashboard-card card-purple">
        <div class="card-icon">
            <i class="fas fa-users"></i>
        </div>
        <div class="card-title">Quản lý nhân viên</div>
        <div class="card-value">
            <i class="fas fa-user-tie"></i>
        </div>
        <a href="/Nhanvien/NhanvienList" class="card-link">
            Xem chi tiết <i class="fas fa-arrow-right"></i>
        </a>
    </div>

    <div class="dashboard-card card-blue">
        <div class="card-icon">
            <i class="fas fa-user-friends"></i>
        </div>
        <div class="card-title">Quản lý khách hàng</div>
        <div class="card-value">
            <i class="fas fa-id-card"></i>
        </div>
        <a href="/Client/ClientList" class="card-link">
            Xem chi tiết <i class="fas fa-arrow-right"></i>
        </a>
    </div>

    <div class="dashboard-card card-pink">
        <div class="card-icon">
            <i class="fas fa-door-open"></i>
        </div>
        <div class="card-title">Quản lý phòng</div>
        <div class="card-value">
            <i class="fas fa-bed"></i>
        </div>
        <a href="/Room/RoomList" class="card-link">
            Xem chi tiết <i class="fas fa-arrow-right"></i>
        </a>
    </div>

    <div class="dashboard-card card-orange">
        <div class="card-icon">
            <i class="fas fa-chart-line"></i>
        </div>
        <div class="card-title">Báo cáo & Thống kê</div>
        <div class="card-value">
            <i class="fas fa-chart-bar"></i> 
        </div>
        <a href="#" class="card-link">
            Xem chi tiết <i class="fas fa-arrow-right"></i>
        </a>
    </div>
</div>

<div class="quick-actions">
    <h2>
        <i class="fas fa-bolt"></i>
        Thao tác nhanh
    </h2>
    <div class="action-buttons">
        <a href="/Nhanvien/Create" class="action-btn action-btn-primary">
            <i class="fas fa-user-plus"></i>
            Thêm nhân viên mới
        </a>
        <a href="/Client/Create" class="action-btn action-btn-success">
            <i class="fas fa-user-plus"></i>
            Thêm khách hàng mới
        </a>
        <a href="/Room/Create" class="action-btn action-btn-warning">
            <i class="fas fa-plus-square"></i>
            Tạo phòng mới
        </a>
        <a href="/Rent/Create" class="action-btn action-btn-info">
            <i class="fas fa-calendar-check"></i>
            Đặt phòng mới
        </a>
    </div>
</div>

<div class="info-section">
    <h3>
        <i class="fas fa-info-circle"></i>
        Thông tin hệ thống
    </h3>
    <p>
        @if (Model != null)
        {
            <strong>Mã quản lý:</strong> @Model.Manv <br>
            <strong>Email:</strong> @Model.Email <br>
            <strong>Số điện thoại:</strong> @Model.Sdt <br>
        }
        <strong>Ngày hôm nay:</strong> @DateTime.Now.ToString("dd/MM/yyyy - HH:mm")
    </p>
</div>

<script>
    // Add some interactivity
    document.querySelectorAll('.dashboard-card').forEach(card => {
        card.addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-8px) scale(1.02)';
        });
        card.addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0) scale(1)';
        });
    });
</script>