@model Nhanvien
@{
    ViewData["Title"] = "Update Nhanvien";
    Layout = "_ManagerLayout";
}
<div class="text-center">
    <h2 class="display-4">CẬP NHẬT THÔNG TIN NHÂN VIÊN</h2>
</div>

<div class="container mt-5">
    <!-- FIX: Hiển thị thông báo chỉ cho Update (không nhầm với Create) -->
    @if (TempData["UpdateSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["UpdateSuccess"]</div>
    }
    @if (TempData["UpdateError"] != null)
    {
        <div class="alert alert-danger">@TempData["UpdateError"]</div>
    }

    <!-- Form truyền ID qua hidden field và route param -->
    <form asp-action="Update" asp-route-nhanvienid="@Model.Manv" method="post">
        <!-- Truyền ID để controller nhận -->
        <!-- Hidden field cho ID (model binder dùng để bind nhanvien.Manv) -->
        <input type="hidden" asp-for="Manv" />

        <!-- Validation summary cho lỗi tổng quát -->
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Hoten" class="font-weight-bold">Họ tên</label>
                    <input type="text" asp-for="Hoten" class="form-control" placeholder="Nhập họ và tên" value="@Model.Hoten" /> <!-- Pre-fill rõ ràng -->
                    <span asp-validation-for="Hoten" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Phai" class="font-weight-bold">Phái</label>
                    <select asp-for="Phai" class="form-control">
                        <option value="">-- Chọn phái --</option>
                        <option value="Nam" selected="@(Model.Phai == "Nam")">Nam</option> <!-- Pre-select giá trị cũ -->
                        <option value="Nữ" selected="@(Model.Phai == "Nữ")">Nữ</option>
                    </select>
                    <span asp-validation-for="Phai" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Ngaysinh" class="font-weight-bold">Ngày sinh</label>
                    <input type="date" asp-for="Ngaysinh" class="form-control" value="@Model.Ngaysinh.ToString("yyyy-MM-dd")" /> <!-- Pre-fill giá trị cũ với format ISO cho type="date" -->
                    <span asp-validation-for="Ngaysinh" class="text-danger"></span>
                    <small class="form-text text-muted">Giá trị hiện tại: @Model.Ngaysinh.ToString("dd/MM/yyyy") (có thể chỉnh sửa nếu cần)</small> <!-- Hiển thị text giá trị cũ -->
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Sdt" class="font-weight-bold">Số điện thoại</label>
                    <input type="tel" asp-for="Sdt" class="form-control" placeholder="0123456789" value="@Model.Sdt" /> <!-- Pre-fill rõ ràng -->
                    <span asp-validation-for="Sdt" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Email" class="font-weight-bold">Email</label>
                    <input type="email" asp-for="Email" class="form-control" placeholder="abc@email.com" value="@Model.Email" /> <!-- Pre-fill rõ ràng -->
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Diachi" class="font-weight-bold">Địa chỉ</label>
                    <input type="text" asp-for="Diachi" class="form-control" placeholder="Nhập địa chỉ chi tiết" value="@Model.Diachi" /> <!-- Pre-fill rõ ràng -->
                    <span asp-validation-for="Diachi" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-md-6 d-flex justify-content-start">
                <a asp-action="NhanvienList" class="btn btn-warning btn-block mr-auto">Xem danh sách nhân viên</a>
            </div>
            <div class="col-md-6 d-flex justify-content-end">
                <button type="submit" class="btn btn-primary btn-block ml-auto">Cập nhật nhân viên</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
     <!-- Client-side validation -->
}