@model Team_Project_4.ViewModels.PaginatedList<Nhanvien>
@{
    ViewData["Title"] = "Nhanvien List";
    Layout = "_ManagerLayout";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
<link rel="stylesheet" href="path/to/font-awesome/css/all.min.css" />
<div class="text-center">
    <h2 class="display-4">QUẢN LÝ NHÂN VIÊN</h2>
</div>

<!-- FIX: Hiển thị thông báo success/error từ TempData ở đây (consume và clear khi load List) -->
@if (TempData["CreateSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["CreateSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["UpdateSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["UpdateSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["DeleteSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["DeleteSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["CreateError"] != null || TempData["UpdateError"] != null || TempData["DeleteError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @(TempData["CreateError"] ?? TempData["UpdateError"] ?? TempData["DeleteError"])
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div style="display: flex; justify-content: space-between; align-items: center ;width:100%">
    <form id="searchForm" asp-controller="Nhanvien" asp-action="NhanvienList" method="get" class="d-flex" style="width:468px">
        <div class="input-group">
            <!-- Search bar -->
            <input value="@ViewData["CurrentFilter"]" name="searchString" id="searchString" type="search" placeholder="Tìm theo mã NV, họ tên, số ĐT, hoặc Email..." class="form-control rounded" aria-label="Search" , style="width:200px">
            <button class="btn btn-info rounded" type="submit">
                <i class="fas fa-search"></i>
            </button>
        </div>
    </form>

    <!-- Link for creating new Nhanvien -->
    <a asp-action="Create" asp-controller="Nhanvien" class="btn btn-primary mb-3 rounded">Thêm nhân viên mới</a>
</div>
<div>
</div>
<table class="table table-striped table-bordered text-center">
    <thead class="thead-dark">
        <tr>
            <th>
                <a asp-action="NhanvienList" asp-route-sortOrder="@(ViewData["ManvSortParam"]?.ToString())" asp-route-sortColumn="Manv" asp-route-currentFilter="@ViewData["CurrentFilter"]">Mã<i class="fas fa-sort"></i></a>
            </th>
            <th>
                <a asp-action="NhanvienList" asp-route-sortOrder="@(ViewData["HotenSortParam"]?.ToString())" asp-route-sortColumn="Hoten" asp-route-currentFilter="@ViewData["CurrentFilter"]">Họ tên<i class="fas fa-sort"></i></a>
            </th>
            <th>Phái</th>
            <th>
                <a asp-action="NhanvienList" asp-route-sortOrder="@(ViewData["NgaysinhSortParam"])" asp-route-sortColumn="Ngaysinh" asp-route-currentFilter="@ViewData["CurrentFilter"]">Ngày sinh<i class="fas fa-sort"></i></a>
            </th>
            <th>Email</th>
            <th>Số điện thoại</th>
            <th>Địa chỉ</th>
            <th>Tác vụ</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var nhanvien in Model.Items)
        {
            var formattedDate = ((DateTime)nhanvien.Ngaysinh).ToString("dd/MM/yyyy");
            <tr>
                <td>@nhanvien.Manv</td>
                <td>@nhanvien.Hoten</td>
                <td>@nhanvien.Phai</td>
                <td>@formattedDate</td>
                <td>@nhanvien.Email</td>
                <td>@nhanvien.Sdt</td>
                <td>@nhanvien.Diachi</td>
                <td>
                    <a asp-action="Update" asp-route-nhanvienid="@nhanvien.Manv" class="btn btn-info btn-sm rounded">Cập nhật</a>
                    <form asp-action="Delete" method="post" asp-route-nhanvienid="@nhanvien.Manv" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm rounded">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="row">
    <div class="col-md-12 text-center">
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                    <a class="page-link text-black" asp-route-pageNumber="1"
                       asp-route-SortOrder="@ViewData["SortOrder"]"
                       asp-route-sortColumn="@ViewData["sortColumn"]"
                       asp-route-currentFilter="@ViewData["CurrentFilter"]">
                        <span>First</span>
                    </a>
                </li>
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link text-black" asp-route-pageNumber="@(Model.PageIndex - 1)"
                       asp-route-SortOrder="@ViewData["SortOrder"]"
                       asp-route-sortColumn="@ViewData["sortColumn"]"
                       asp-route-currentFilter="@ViewData["CurrentFilter"]">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @if (Model.TotalPages <= 5)
                {
                    for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                            <a class="page-link text-black" asp-route-pageNumber="@i"
                               asp-route-SortOrder="@ViewData["SortOrder"]"
                               asp-route-sortColumn="@ViewData["sortColumn"]"
                               asp-route-currentFilter="@ViewData["CurrentFilter"]">@i</a>
                        </li>
                    }
                }
                else
                {
                    @if (Model.PageIndex <= 3)
                    {
                        for (int i = 1; i <= 5; i++)
                        {
                            <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                                <a class="page-link text-black" asp-route-pageNumber="@i"
                                   asp-route-SortOrder="@ViewData["SortOrder"]"
                                   asp-route-sortColumn="@ViewData["sortColumn"]"
                                   asp-route-currentFilter="@ViewData["CurrentFilter"]">@i</a>
                            </li>
                        }
                    }
                    else if (Model.PageIndex >= Model.TotalPages - 2)
                    {
                        for (int i = Model.TotalPages - 4; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                                <a class="page-link text-black" asp-route-pageNumber="@i"
                                   asp-route-SortOrder="@ViewData["SortOrder"]"
                                   asp-route-sortColumn="@ViewData["sortColumn"]"
                                   asp-route-currentFilter="@ViewData["CurrentFilter"]">@i</a>
                            </li>
                        }
                    }
                    else
                    {
                        for (int i = Model.PageIndex - 2; i <= Model.PageIndex + 2; i++)
                        {
                            <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                                <a class="page-link text-black" asp-route-pageNumber="@i"
                                   asp-route-SortOrder="@ViewData["SortOrder"]"
                                   asp-route-sortColumn="@ViewData["sortColumn"]"
                                   asp-route-currentFilter="@ViewData["CurrentFilter"]">@i</a>
                            </li>
                        }
                    }
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link text-black" asp-route-pageNumber="@(Model.PageIndex + 1)"
                       asp-route-SortOrder="@ViewData["SortOrder"]"
                       asp-route-sortColumn="@ViewData["sortColumn"]"
                       asp-route-currentFilter="@ViewData["CurrentFilter"]">

                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
                <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link text-black" asp-route-pageNumber="@Model.TotalPages"
                       asp-route-SortOrder="@ViewData["SortOrder"]"
                       asp-route-sortColumn="@ViewData["sortColumn"]"
                       asp-route-currentFilter="@ViewData["CurrentFilter"]">

                        <span>Last</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<script>
    // Helper remove dấu tiếng Việt cho JS preview
    function removeVietnameseAccents(text) {
        if (!text) return text;
        var map = {
            'à': 'a', 'á': 'a', 'ạ': 'a', 'ả': 'a', 'ã': 'a', 'â': 'a', 'ầ': 'a', 'ấ': 'a', 'ậ': 'a', 'ẩ': 'a', 'ẫ': 'a', 'ă': 'a', 'ằ': 'a', 'ắ': 'a', 'ặ': 'a', 'ẳ': 'a', 'ẵ': 'a',
            'è': 'e', 'é': 'e', 'ẹ': 'e', 'ẻ': 'e', 'ẽ': 'e', 'ê': 'e', 'ề': 'e', 'ế': 'e', 'ệ': 'e', 'ể': 'e', 'ễ': 'e',
            'ì': 'i', 'í': 'i', 'ị': 'i', 'ỉ': 'i', 'ĩ': 'i',
            'ò': 'o', 'ó': 'o', 'ọ': 'o', 'ỏ': 'o', 'õ': 'o', 'ô': 'o', 'ồ': 'o', 'ố': 'o', 'ộ': 'o', 'ổ': 'o', 'ỗ': 'o', 'ơ': 'o', 'ờ': 'o', 'ớ': 'o', 'ợ': 'o', 'ở': 'o', 'ỡ': 'o',
            'ù': 'u', 'ú': 'u', 'ụ': 'u', 'ủ': 'u', 'ũ': 'u', 'ư': 'u', 'ừ': 'u', 'ứ': 'u', 'ự': 'u', 'ử': 'u', 'ữ': 'u',
            'ỳ': 'y', 'ý': 'y', 'ỵ': 'y', 'ỷ': 'y', 'ỹ': 'y',
            'đ': 'd',
            'À': 'A', 'Á': 'A', 'Ạ': 'A', 'Ả': 'A', 'Ã': 'A', 'Â': 'A', 'Ầ': 'A', 'Ấ': 'A', 'Ậ': 'A', 'Ẩ': 'A', 'Ẫ': 'A', 'Ă': 'A', 'Ằ': 'A', 'Ắ': 'A', 'Ặ': 'A', 'Ẳ': 'A', 'Ẵ': 'A',
            'È': 'E', 'É': 'E', 'Ẹ': 'E', 'Ẻ': 'E', 'Ẽ': 'E', 'Ê': 'E', 'Ề': 'E', 'Ế': 'E', 'Ệ': 'E', 'Ể': 'E', 'Ễ': 'E',
            'Ì': 'I', 'Í': 'I', 'Ị': 'I', 'Ỉ': 'I', 'Ĩ': 'I',
            'Ò': 'O', 'Ó': 'O', 'Ọ': 'O', 'Ỏ': 'O', 'Õ': 'O', 'Ô': 'O', 'Ồ': 'O', 'Ố': 'O', 'Ộ': 'O', 'Ổ': 'O', 'Ỗ': 'O', 'Ơ': 'O', 'Ờ': 'O', 'Ớ': 'O', 'Ợ': 'O', 'Ở': 'O', 'Ỡ': 'O',
            'Ù': 'U', 'Ú': 'U', 'Ụ': 'U', 'Ủ': 'U', 'Ũ': 'U', 'Ư': 'U', 'Ừ': 'U', 'Ứ': 'U', 'Ự': 'U', 'Ử': 'U', 'Ữ': 'U',
            'Ỳ': 'Y', 'Ý': 'Y', 'Ỵ': 'Y', 'Ỷ': 'Y', 'Ỹ': 'Y',
            'Đ': 'D'
        };
        return text.split('').map(function(char) {
            return map[char] || char;
        }).join('').replace(/\s+/g, '');
    }

    // Realtime search suggestion (client-side preview)
    document.getElementById('searchString').addEventListener('input', function () {
        var searchTerm = removeVietnameseAccents(this.value.toLowerCase());
        var rows = document.querySelectorAll('#NhanvienListTable tbody tr');

        rows.forEach(row => {
            var manv = removeVietnameseAccents(row.cells[0].textContent.toLowerCase()); // Mã NV
            var hoten = removeVietnameseAccents(row.cells[1].textContent.toLowerCase()); // Họ tên
            var sdt = removeVietnameseAccents(row.cells[5].textContent.toLowerCase()); // Số ĐT
            var email = removeVietnameseAccents(row.cells[4].textContent.toLowerCase()); // Email
            if (manv.includes(searchTerm) || hoten.includes(searchTerm) || sdt.includes(searchTerm) || email.includes(searchTerm)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

    // Ensure table ID is set for JavaScript targeting
    document.querySelector('table').id = 'NhanvienListTable';
</script>