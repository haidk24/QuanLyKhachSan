@model Team_Project_4.Models.Hoadon

@{
    ViewData["Title"] = "Details";
    Layout = "_BaseView";
}

<div class="d-flex justify-content-center align-items-start" style="min-height: 80vh;">
    <div class="card shadow-sm border-light w-75 mt-5">
        <div class="card-header bg-dark text-white text-center">
            <h3 class="mb-0">CHI TIẾT HÓA ĐƠN</h3>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-md-3 font-weight-bold">Tên Khách Hàng</dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.Tenkh)</dd>

                <dt class="col-md-3 font-weight-bold">CCCD</dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.Cccd)</dd>

                <dt class="col-md-3 font-weight-bold">Tên Phòng</dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.Tenphong)</dd>

                <dt class="col-md-3 font-weight-bold">Ngày Đến</dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.Ngaydat)</dd>

                <dt class="col-md-3 font-weight-bold">Ngày Đi</dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.Ngaylaphd)</dd>

                <dt class="col-md-3 font-weight-bold">Số Ngày Ở</dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.Songayo)</dd>

                <dt class="col-md-3 font-weight-bold">Tổng Tiền</dt>
                <dd class="col-md-9 text-success font-weight-bold">@Html.DisplayFor(model => model.Tongtien) VND</dd>

                <dt class="col-md-3 font-weight-bold">Phụ Thu</dt>
                <dd class="col-md-9">@Html.DisplayFor(model => model.Tylephuthu)%</dd>
            </dl>
        </div>
        <div class="card-footer text-center bg-light">
            <a asp-action="Index" class="btn btn-warning">
                <i class="bi bi-arrow-left"></i> Quay lại lịch sử hóa đơn
            </a>
        </div>
    </div>
</div>

